# Sao chép thành .env, không commit .env
DATABASE_URL=postgresql+psycopg://sme:sme@localhost:5432/sme_ci
ANTHROPIC_API_KEY=

# Tên model đặt ở đây, không hard-code. Chọn theo docs.claude.com
MODEL_REASONING=
# (Đã bỏ biến model rẻ: không có mã nào trong backend/ đọc nó.)
# low | medium | high | xhigh | max
LLM_EFFORT=medium
# Tiền tố tên model không nhận effort, cách nhau dấu phẩy (ví dụ model nhỏ). Để trống = mọi model nhận effort.
LLM_NO_EFFORT_MODELS=
LLM_MAX_TOKENS=4096
