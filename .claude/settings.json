{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.autodev/guard.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "developer",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.autodev/verify.py\" --hook",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
